# =============================================================================
# Environment Variables — Job Search Platform
# =============================================================================
# Copy this file as .env in each service's directory and fill in the values.
# NEVER commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Job Posting Service (Spring Boot, port 8081)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=default
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobsearch
SPRING_DATASOURCE_USERNAME=jobsearch
SPRING_DATASOURCE_PASSWORD=devpass
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NEW_JOBS=new-job-postings
SERVICEBUS_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# Job Search Service (Spring Boot, port 8082)
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=default
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_MONGODB_URI=mongodb://root:devpass@localhost:27017/jobsearch?authSource=admin
# JOB_POSTING_SERVICE_URL=http://localhost:8081
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# API Gateway (Spring Cloud Gateway, port 8080)
# -----------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=default
# JOB_POSTING_URL=http://localhost:8081
# JOB_SEARCH_URL=http://localhost:8082
# NOTIFICATION_URL=http://localhost:8083
# AI_AGENT_URL=http://localhost:8084
# FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Notification Service (Node, port 8083)
# -----------------------------------------------------------------------------
# PORT=8083
# MONGO_URL=mongodb://root:devpass@localhost:27017
# MONGO_DB=jobsearch
# POSTGRES_URL=postgresql://jobsearch:devpass@localhost:5432/jobsearch
# SERVICEBUS_CONNECTION_STRING=
# SERVICEBUS_QUEUE=new-job-postings
# JOB_POSTING_SERVICE_URL=http://localhost:8081
# FIREBASE_CREDENTIALS_JSON=
# CRON_SECRET=changeme-long-random-string

# -----------------------------------------------------------------------------
# AI Agent Service (Node, port 8084)
# -----------------------------------------------------------------------------
# PORT=8084
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-7
# GATEWAY_URL=http://localhost:8080
# FIREBASE_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# Frontend (Vite, build-time variables)
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8080
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
